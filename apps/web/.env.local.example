# Server-only: the browser never calls the API directly (JWT lives in an httpOnly cookie).
API_URL=http://localhost:4000/api/v1
# Production: the single-IP header your edge proxy sets and overwrites, e.g. cf-connecting-ip or x-real-ip.
# Never x-forwarded-for (browsers can write it). Leave unset locally.
# CLIENT_IP_HEADER=cf-connecting-ip
# Public API URL shown on the AI Connectors page (outside AI apps call it). Defaults to API_URL.
# API_PUBLIC_URL=https://api.example.com/api/v1
