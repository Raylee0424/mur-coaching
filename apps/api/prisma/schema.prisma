generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────── Enums ───────────────

enum Role {
  COACH
  CLIENT
}

enum CoachClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WeightUnit {
  KG
  LB
}

enum Experience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ScheduledStatus {
  PLANNED
  COMPLETED
  SKIPPED
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  CORE
  FULL_BODY
}

enum Equipment {
  BARBELL
  DUMBBELL
  CABLE
  MACHINE
  SMITH_MACHINE
  BODYWEIGHT
  KETTLEBELL
  BAND
  SPECIALTY_BAR
  OTHER
}

enum MuscleRole {
  PRIMARY
  SECONDARY
}

/// Where in the range of motion the exercise loads the muscle hardest.
enum ResistanceProfile {
  LENGTHENED
  MID_RANGE
  SHORTENED
}

enum ExercisePosition {
  STANDING
  SEATED
  SUPPORTED // prone or chest-supported
  LYING // supine
}

/// Movement-pattern tag. Joint limitations map to patterns through JOINT_PATTERNS in @coaching/shared.
enum MovementPattern {
  SQUAT
  HINGE
  LUNGE
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  CARRY
  CORE
  ARM_ISOLATION
  LEG_ISOLATION
}

enum Joint {
  NECK
  SHOULDER
  ELBOW
  WRIST
  LOWER_BACK
  HIP
  KNEE
  ANKLE
}

enum LimitationTarget {
  MUSCLE
  EXERCISE
  JOINT
  PATTERN
}

enum LimitationSeverity {
  AVOID
  CAUTION
}

enum RecommendationAction {
  INCREASE_LOAD // hit top of rep range at/under target RPE
  INCREASE_REPS // double progression: add reps at same load
  HOLD // insufficient data or missed targets
  DELOAD // plateau + RPE >= 9 across consecutive sessions, or e1RM declining
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  DISMISSED
  SUPERSEDED // replaced by a newer evaluation
}

// ─────────────── Identity & Tenancy ───────────────

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  name             String
  role             Role
  isDemo           Boolean    @default(false)
  weightUnit       WeightUnit @default(KG)
  displayName      String?
  onboardedAt      DateTime?
  /// Null until the user confirms the 6-digit code (invite acceptance verifies implicitly).
  emailVerifiedAt  DateTime?
  /// Consecutive failed logins; 5 in a row sets lockedUntil.
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // COACH side
  coachedClients  CoachClient[]     @relation("CoachSide")
  programs        Program[]
  clientGroups    ClientGroup[]
  sessionFeedback SessionFeedback[]
  exercises       Exercise[]        @relation("CoachExercises") // coach-owned custom exercises
  engineRules     CoachEngineRules?

  // CLIENT side
  coachLink         CoachClient?                @relation("ClientSide")
  assignments       ProgramAssignment[]
  workoutLogs       WorkoutLog[]
  recommendations   ProgressionRecommendation[]
  clientProfile     ClientProfile?
  groupMemberships  ClientGroupMember[]
  baselines         ClientBaseline[]
  limitations       Limitation[]
  templateFolders   TemplateFolder[]
  workoutTemplates  WorkoutTemplate[]
  exerciseNotes     ExerciseNote[]
  personalRecords   PersonalRecord[]
  scheduledWorkouts ScheduledWorkout[]
  ownedExercises    Exercise[]                  @relation("OwnedExercises") // athlete's own custom exercises

  authTokens AuthToken[]
  invites    Invite[]

  @@index([role])
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Single-use verification codes and reset tokens. Only the sha256 hash is stored, never the raw value.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  /// Wrong guesses against a 6-digit code; the code dies after a few.
  attempts  Int           @default(0)
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId, type])
}

/// Coach-issued invitation. The raw token only exists in the one-time invite URL; the hash is stored.
model Invite {
  id         String     @id @default(cuid())
  coachId    String
  name       String
  email      String
  phone      String?
  programId  String?
  startDate  DateTime?  @db.Date
  weightUnit WeightUnit @default(KG)
  tokenHash  String     @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())

  coach   User     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([coachId, acceptedAt])
}

/// Tenancy boundary. One active coach per client (MVP).
model CoachClient {
  id        String            @id @default(cuid())
  coachId   String
  clientId  String            @unique
  status    CoachClientStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime          @default(now())

  // Per-client engine overrides (null = inherit coach rules / defaults).
  loadIncrementKg  Decimal? @db.Decimal(5, 2)
  rpeCap           Decimal? @db.Decimal(3, 1)
  repsMin          Int?
  repsMax          Int?
  deloadPercent    Int?
  sessionsAnalyzed Int?
  autoApprove      Boolean  @default(false)
  /// Auto-approve only INCREASE_LOAD calls whose jump is at most this; null = any size.
  autoApproveMaxKg Decimal? @db.Decimal(5, 2)

  coach  User @relation("CoachSide", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("ClientSide", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([coachId, status])
}

// ─────────────── Exercise Catalog ───────────────

/// Global when coachId and ownerId are both null; coachId = coach's custom exercise; ownerId = an athlete's own
/// custom exercise. Never both (CHECK in migration).
model Exercise {
  id              String             @id @default(cuid())
  name            String
  /// Main primary muscle: the engine, swaps and filters key on it. Also stored as a PRIMARY row in `muscles`.
  muscleGroup     MuscleGroup
  equipment       Equipment?
  pattern         MovementPattern?
  profile         ResistanceProfile?
  position        ExercisePosition?
  /// Smallest load jump used by the engine (e.g. 2.5 upper, 5.0 lower).
  loadIncrementKg Decimal            @default(2.5) @db.Decimal(5, 2)
  /// Exercise-level engine rules (null = inherit). Layer between client override and prescription.
  rpeCap          Decimal?           @db.Decimal(3, 1)
  repsMin         Int?
  repsMax         Int?
  /// Soft delete: hidden from lists and pickers, history stays intact.
  archivedAt      DateTime?
  coachId         String?
  ownerId         String?
  createdAt       DateTime           @default(now())

  coach             User?                       @relation("CoachExercises", fields: [coachId], references: [id], onDelete: Cascade)
  owner             User?                       @relation("OwnedExercises", fields: [ownerId], references: [id], onDelete: Cascade)
  muscles           ExerciseMuscle[]
  workoutExercises  WorkoutExercise[]
  exerciseLogs      ExerciseLog[]
  recommendations   ProgressionRecommendation[]
  swappedFromLogs   ExerciseLog[]               @relation("SwappedFrom")
  baselines         ClientBaseline[]
  limitations       Limitation[]
  templateExercises WorkoutTemplateExercise[]
  exerciseNotes     ExerciseNote[]
  personalRecords   PersonalRecord[]

  @@unique([coachId, name])
  @@unique([ownerId, name])
  @@index([muscleGroup])
}

/// Every muscle an exercise trains. The exercise's own `muscleGroup` is always one of the PRIMARY rows.
model ExerciseMuscle {
  exerciseId String
  muscle     MuscleGroup
  role       MuscleRole

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscle])
  @@index([muscle])
}

// ─────────────── Program Templates ───────────────

model Program {
  id             String   @id @default(cuid())
  coachId        String
  name           String
  description    String?
  durationWeeks  Int
  isTemplate     Boolean  @default(false)
  /// SHA-256 (hex) of the read-only preview token. The raw token is shown once and never stored.
  shareTokenHash String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  coach       User                   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  workouts    Workout[]
  assignments ProgramAssignment[]
  invites     Invite[]
  mesocycles  Mesocycle[]
  sports      ProgramSportCategory[]

  @@index([coachId])
}

/// One training day inside a program (e.g. Week 2 / Day 1 "Upper A").
model Workout {
  id         String @id @default(cuid())
  programId  String
  weekNumber Int // 1..durationWeeks
  dayNumber  Int // 1..7
  name       String

  program     Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
  workoutLogs WorkoutLog[]
  scheduled   ScheduledWorkout[]

  @@unique([programId, weekNumber, dayNumber])
}

/// Prescription for one exercise in a workout.
model WorkoutExercise {
  id             String   @id @default(cuid())
  workoutId      String
  exerciseId     String
  order          Int
  targetSets     Int
  targetRepsMin  Int
  targetRepsMax  Int
  targetRpe      Decimal? @db.Decimal(3, 1)
  targetWeightKg Decimal? @db.Decimal(6, 2)
  restSeconds    Int?
  notes          String?

  workout      Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise     Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  exerciseLogs ExerciseLog[]

  @@unique([workoutId, order])
  @@index([exerciseId])
}

/// Program instance for a specific client.
model ProgramAssignment {
  id        String           @id @default(cuid())
  programId String
  clientId  String
  startDate DateTime         @db.Date
  status    AssignmentStatus @default(ACTIVE)
  /// Set when assigned through a client group (bulk assign).
  groupId   String?
  createdAt DateTime         @default(now())

  program     Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  client      User               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group       ClientGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  workoutLogs WorkoutLog[]
  scheduled   ScheduledWorkout[]
  // Partial unique "one ACTIVE per client" added in raw migration SQL.

  @@index([clientId, status])
  @@index([groupId])
}

// ─────────────── Logging (actuals) ───────────────

/// One performed session.
model WorkoutLog {
  id           String   @id @default(cuid())
  clientId     String
  assignmentId String?
  workoutId    String? // template day this session followed; null = ad-hoc
  performedAt  DateTime
  notes        String?
  createdAt    DateTime @default(now())

  client       User               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignment   ProgramAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  workout      Workout?           @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  exerciseLogs ExerciseLog[]
  feedback     SessionFeedback[]

  @@index([clientId, performedAt(sort: Desc)])
}

/// One exercise performed within a session. Engine's unit of history.
model ExerciseLog {
  id                    String  @id @default(cuid())
  workoutLogId          String
  exerciseId            String
  workoutExerciseId     String? // prescription it fulfilled (targets snapshot source)
  order                 Int
  /// Set when the client swapped away from the prescribed exercise.
  swappedFromExerciseId String?
  swapReason            String?
  /// Free-text note on this lift in this session.
  notes                 String?

  workoutLog      WorkoutLog        @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise        Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  swappedFrom     Exercise?         @relation("SwappedFrom", fields: [swappedFromExerciseId], references: [id], onDelete: SetNull)
  workoutExercise WorkoutExercise?  @relation(fields: [workoutExerciseId], references: [id], onDelete: SetNull)
  sets            SetLog[]
  feedback        SessionFeedback[]

  @@unique([workoutLogId, order])
  @@index([exerciseId, workoutLogId])
}

model SetLog {
  id            String   @id @default(cuid())
  exerciseLogId String
  setNumber     Int
  reps          Int
  weightKg      Decimal  @db.Decimal(6, 2)
  rpe           Decimal? @db.Decimal(3, 1) // CHECK (rpe BETWEEN 1 AND 10) in migration
  isWarmup      Boolean  @default(false)
  /// Reps in reserve; CHECK (rir BETWEEN 0 AND 10) in migration.
  rir           Int?
  /// Free text such as `3-1-1-0`; shape validated by the API.
  tempo         String?  @db.VarChar(16)
  /// Rest taken before this set; CHECK (restSeconds BETWEEN 0 AND 3600) in migration.
  restSeconds   Int?

  exerciseLog    ExerciseLog       @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  personalRecord PersonalRecord?
  feedback       SessionFeedback[]

  @@unique([exerciseLogId, setNumber])
}

// ─────────────── Progression Engine Output ───────────────

model ProgressionRecommendation {
  id                   String               @id @default(cuid())
  clientId             String
  exerciseId           String
  action               RecommendationAction
  status               RecommendationStatus @default(PENDING)
  recommendedWeightKg  Decimal?             @db.Decimal(6, 2)
  recommendedRepsMin   Int?
  recommendedRepsMax   Int?
  recommendedSets      Int?
  reason               String // human-readable rule explanation
  /// Metrics snapshot the decision used: per-session volume, top-set e1RM, avg RPE.
  metrics              Json
  /// ExerciseLog ids analysed (2–3), for auditability.
  sourceExerciseLogIds String[]
  createdAt            DateTime             @default(now())
  resolvedAt           DateTime?
  /// Coach override of the engine target (the engine fields above stay untouched).
  overrideWeightKg     Decimal?             @db.Decimal(6, 2)
  overrideRepsMin      Int?
  overrideRepsMax      Int?
  overrideRpe          Decimal?             @db.Decimal(3, 1)
  overrideNote         String?
  overriddenById       String?
  overriddenAt         DateTime?
  autoApproved         Boolean              @default(false)
  /// Resolved engine settings with the source of each value.
  settings             Json?

  client   User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([clientId, exerciseId, createdAt(sort: Desc)])
  @@index([clientId, status])
}

// ─────────────── Profiles, baselines, coach rules ───────────────

model ClientProfile {
  clientId         String      @id
  goals            String[]
  goalNote         String?
  experience       Experience?
  daysPerWeek      Int?
  /// ISO weekdays, 1 = Monday … 7 = Sunday.
  trainingDays     Int[]
  sessionLengthMin Int?
  limitations      String[]
  limitationsNote  String?
  updatedAt        DateTime    @updatedAt

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/// Starting weight from onboarding; used to prefill the logger before history exists.
model ClientBaseline {
  id         String   @id @default(cuid())
  clientId   String
  exerciseId String
  weightKg   Decimal? @db.Decimal(6, 2)
  reps       Int?
  unknown    Boolean  @default(false)

  client   User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([clientId, exerciseId])
}

/// Coach-level engine thresholds. Null = engine default.
model CoachEngineRules {
  coachId             String   @id
  rpeCap              Decimal? @db.Decimal(3, 1)
  loadMarginRpe       Decimal? @db.Decimal(3, 1)
  highRpe             Decimal? @db.Decimal(3, 1)
  plateauTolerancePct Decimal? @db.Decimal(4, 2)
  declineThresholdPct Decimal? @db.Decimal(4, 2)
  deloadPercent       Int?
  sessionsAnalyzed    Int?
  updatedAt           DateTime @updatedAt

  coach User @relation(fields: [coachId], references: [id], onDelete: Cascade)
}

/// A client's injury or limitation. Advisory only: it flags prescriptions and sorts swaps, it never blocks logging.
/// Exactly one target column is set, matching `target` (enforced by a CHECK): muscleGroup, exerciseId, joint or pattern.
model Limitation {
  id          String             @id @default(cuid())
  clientId    String
  target      LimitationTarget
  muscleGroup MuscleGroup?
  exerciseId  String?
  joint       Joint?
  pattern     MovementPattern?
  severity    LimitationSeverity
  note        String?
  startsOn    DateTime           @db.Date
  endsOn      DateTime?          @db.Date
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  client   User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([clientId, endsOn])
}

// ─────────────── Templates and notes ───────────────

/// A client's folder of workout templates. Names are unique per client.
model TemplateFolder {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  createdAt DateTime @default(now())

  client    User              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templates WorkoutTemplate[]

  @@unique([clientId, name])
}

/// A reusable freeform workout the client starts from the logger. Deleting a folder keeps its templates.
model WorkoutTemplate {
  id        String   @id @default(cuid())
  clientId  String
  folderId  String?
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    User                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  folder    TemplateFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  exercises WorkoutTemplateExercise[]

  @@index([clientId, folderId])
}

model WorkoutTemplateExercise {
  id          String  @id @default(cuid())
  templateId  String
  exerciseId  String
  order       Int
  targetSets  Int
  repsMin     Int?
  repsMax     Int?
  restSeconds Int?
  tempo       String? @db.VarChar(16)

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([templateId, order])
}

/// A persistent note on one exercise (cues, setup, what to fix). Shown every time the client logs it.
model ExerciseNote {
  id         String   @id @default(cuid())
  clientId   String
  exerciseId String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client   User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([clientId, exerciseId])
}

/// Heaviest working set a client has done at an exact rep count. Warm-ups never count. Derived from logs:
/// `RecordsService.rebuild` recomputes a client's rows for an exercise whenever a log is created, edited or deleted.
model PersonalRecord {
  id         String   @id @default(cuid())
  clientId   String
  exerciseId String
  reps       Int
  weightKg   Decimal  @db.Decimal(6, 2)
  /// Epley estimate of the record set.
  e1rmKg     Decimal  @db.Decimal(6, 2)
  setLogId   String   @unique
  achievedAt DateTime

  client   User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setLog   SetLog   @relation(fields: [setLogId], references: [id], onDelete: Cascade)

  @@unique([clientId, exerciseId, reps])
  @@index([clientId, achievedAt(sort: Desc)])
}

// ─────────────── Periodization ───────────────

/// A training block (e.g. weeks 1-4 hypertrophy) inside a program. Weeks never overlap between blocks.
model Mesocycle {
  id        String  @id @default(cuid())
  programId String
  name      String
  focus     String?
  startWeek Int
  endWeek   Int
  position  Int

  program     Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  microcycles Microcycle[]

  @@index([programId, position])
}

/// A run of weeks inside a mesocycle with a shared intensity / volume intent (a deload week is a microcycle).
model Microcycle {
  id             String   @id @default(cuid())
  mesocycleId    String
  label          String
  startWeek      Int
  endWeek        Int
  isDeload       Boolean  @default(false)
  rpeMin         Decimal? @db.Decimal(3, 1)
  rpeMax         Decimal? @db.Decimal(3, 1)
  /// Volume change versus the block baseline, percent (e.g. -35 on a deload).
  volumeDeltaPct Int?

  mesocycle Mesocycle @relation(fields: [mesocycleId], references: [id], onDelete: Cascade)

  @@index([mesocycleId])
}

/// Seeded catalog of sports / disciplines a program is built for. `id` is the slug.
model SportCategory {
  id    String @id
  name  String @unique
  /// Display grouping, e.g. "Strength", "Field", "Combat".
  group String

  programs ProgramSportCategory[]
}

model ProgramSportCategory {
  programId       String
  sportCategoryId String

  program Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  sport   SportCategory @relation(fields: [sportCategoryId], references: [id], onDelete: Cascade)

  @@id([programId, sportCategoryId])
  @@index([sportCategoryId])
}

// ─────────────── Client groups ───────────────

model ClientGroup {
  id        String   @id @default(cuid())
  coachId   String
  name      String
  createdAt DateTime @default(now())

  coach       User                @relation(fields: [coachId], references: [id], onDelete: Cascade)
  members     ClientGroupMember[]
  assignments ProgramAssignment[]

  @@unique([coachId, name])
}

model ClientGroupMember {
  groupId  String
  clientId String

  group  ClientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  client User        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([groupId, clientId])
  @@index([clientId])
}

// ─────────────── Calendar ───────────────

/// One dated session on a client's calendar. Created from the program's (week, day) formula, then the coach may
/// move or skip it. Completed rows are history and never change; program edits touch future PLANNED rows only.
model ScheduledWorkout {
  id           String          @id @default(cuid())
  assignmentId String
  workoutId    String
  clientId     String
  date         DateTime        @db.Date
  status       ScheduledStatus @default(PLANNED)
  /// Set when a coach moved it: program edits no longer re-date it.
  movedAt      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  assignment ProgramAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  workout    Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  client     User              @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, workoutId])
  @@index([clientId, date])
}

// ─────────────── Session review ───────────────

/// Coach feedback on a logged session. Scope: setLogId set = one set; else exerciseLogId set = one lift; else whole
/// session. `carryForward` pins it to the client's next matching exercise (or next session) in `GET /me/today`.
model SessionFeedback {
  id            String   @id @default(cuid())
  workoutLogId  String
  exerciseLogId String?
  setLogId      String?
  coachId       String
  body          String   @db.VarChar(1000)
  carryForward  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workoutLog  WorkoutLog   @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exerciseLog ExerciseLog? @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  setLog      SetLog?      @relation(fields: [setLogId], references: [id], onDelete: Cascade)
  coach       User         @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([workoutLogId])
  @@index([exerciseLogId])
}
