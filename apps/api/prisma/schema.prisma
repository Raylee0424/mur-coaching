generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────── Enums ───────────────

enum Role {
  COACH
  CLIENT
}

enum CoachClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WeightUnit {
  KG
  LB
}

enum Experience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ScheduledStatus {
  PLANNED
  COMPLETED
  SKIPPED
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  CORE
  FULL_BODY
}

enum Equipment {
  BARBELL
  DUMBBELL
  CABLE
  MACHINE
  SMITH_MACHINE
  BODYWEIGHT
  KETTLEBELL
  BAND
  SPECIALTY_BAR
  OTHER
}

enum MuscleRole {
  PRIMARY
  SECONDARY
}

/// Where in the range of motion the exercise loads the muscle hardest.
enum ResistanceProfile {
  LENGTHENED
  MID_RANGE
  SHORTENED
}

enum ExercisePosition {
  STANDING
  SEATED
  SUPPORTED // prone or chest-supported
  LYING // supine
}

/// Movement-pattern tag. Joint limitations map to patterns through JOINT_PATTERNS in @coaching/shared.
enum MovementPattern {
  SQUAT
  HINGE
  LUNGE
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  CARRY
  CORE
  ARM_ISOLATION
  LEG_ISOLATION
}

enum Joint {
  NECK
  SHOULDER
  ELBOW
  WRIST
  LOWER_BACK
  HIP
  KNEE
  ANKLE
}

enum LimitationTarget {
  MUSCLE
  EXERCISE
  JOINT
  PATTERN
}

enum LimitationSeverity {
  AVOID
  CAUTION
}

enum RecommendationAction {
  INCREASE_LOAD // hit top of rep range at/under target RPE
  INCREASE_REPS // double progression: add reps at same load
  HOLD // insufficient data or missed targets
  DELOAD // plateau + RPE >= 9 across consecutive sessions, or e1RM declining
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  DISMISSED
  SUPERSEDED // replaced by a newer evaluation
}

// ─────────────── Identity & Tenancy ───────────────

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  passwordHash         String
  name                 String
  role                 Role
  isDemo               Boolean    @default(false)
  weightUnit           WeightUnit @default(KG)
  displayName          String?
  onboardedAt          DateTime?
  /// Null until the user confirms the 6-digit code (invite acceptance verifies implicitly).
  emailVerifiedAt      DateTime?
  /// Consecutive failed logins; 5 in a row sets lockedUntil.
  failedLoginCount     Int        @default(0)
  lockedUntil          DateTime?
  /// Platform Stripe customer (platform plan and coach-offer purchases share it). Never card data.
  stripeCustomerId     String?    @unique
  /// COACH: Stripe Connect Express account that receives offer payments.
  stripeAccountId      String?    @unique
  /// Mirrors the Connect account's charges_enabled (account.updated webhook).
  stripeChargesEnabled Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // COACH side
  coachedClients  CoachClient[]     @relation("CoachSide")
  programs        Program[]
  clientGroups    ClientGroup[]
  sessionFeedback SessionFeedback[]
  exercises       Exercise[]        @relation("CoachExercises") // coach-owned custom exercises
  engineRules     CoachEngineRules?

  // CLIENT side
  coachLink         CoachClient?                @relation("ClientSide")
  assignments       ProgramAssignment[]
  workoutLogs       WorkoutLog[]
  recommendations   ProgressionRecommendation[]
  clientProfile     ClientProfile?
  groupMemberships  ClientGroupMember[]
  baselines         ClientBaseline[]
  limitations       Limitation[]
  templateFolders   TemplateFolder[]
  workoutTemplates  WorkoutTemplate[]
  exerciseNotes     ExerciseNote[]
  personalRecords   PersonalRecord[]
  scheduledWorkouts ScheduledWorkout[]
  ownedExercises    Exercise[]                  @relation("OwnedExercises") // athlete's own custom exercises

  authTokens AuthToken[]
  invites    Invite[]

  // Billing
  subscription        Subscription?
  billingEvents       BillingEvent[]
  coachOffers         CoachOffer[]
  soldSubscriptions   ClientSubscription[] @relation("CoachSales")
  boughtSubscriptions ClientSubscription[] @relation("ClientPurchases")
  receivedPayments    Payment[]            @relation("CoachPayments")
  madePayments        Payment[]            @relation("ClientPayments")

  // Pipeline, vault, roadmaps
  brand           CoachBrand?
  intakeForm      IntakeForm?
  leads           Lead[]          @relation("CoachLeads")
  convertedFrom   Lead?           @relation("ConvertedLead")
  resources       Resource[]
  resourceShares  ResourceShare[]
  coachedRoadmaps ClientRoadmap[] @relation("CoachRoadmaps")
  roadmap         ClientRoadmap?  @relation("ClientRoadmap")
  events          ClientEvent[]

  // Messaging, check-ins, body
  coachConversations  Conversation[]    @relation("CoachConversations")
  clientConversations Conversation[]    @relation("ClientConversations")
  sentMessages        Message[]
  messageReads        MessageRead[]
  checkInTemplates    CheckInTemplate[]
  checkInSchedules    CheckInSchedule[]
  checkInResponses    CheckInResponse[]
  bodyweightEntries   BodyweightEntry[]
  bodyGoal            BodyGoal?
  progressPhotos      ProgressPhoto[]

  // Videos, form checks, calls, automations, live sessions
  mediaAssets       MediaAsset[]
  setVideos         SetVideo[]
  clientReviews     FormReview[]      @relation("ClientFormReviews")
  coachReviews      FormReview[]      @relation("CoachFormReviews")
  availability      Availability?
  coachBookings     Booking[]         @relation("CoachBookings")
  clientBookings    Booking[]         @relation("ClientBookings")
  automationRules   AutomationRule[]
  automationRuns    AutomationRun[]
  liveSessions      LiveSession[]
  liveParticipation LiveParticipant[]
  loggedForOthers   WorkoutLog[]      @relation("LoggedBy")

  // Nutrition
  foods           Food[]
  mealEntries     MealEntry[]
  waterLogs       WaterLog[]
  nutritionTarget NutritionTarget?  @relation("TargetClient")
  targetsSet      NutritionTarget[] @relation("TargetSetter")
  mealTemplates   MealTemplate[]
  foodFavorites   FoodFavorite[]
  coachMealPlans  MealPlan[]        @relation("CoachMealPlans")
  clientMealPlans MealPlan[]        @relation("ClientMealPlans")

  @@index([role])
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Single-use verification codes and reset tokens. Only the sha256 hash is stored, never the raw value.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  /// Wrong guesses against a 6-digit code; the code dies after a few.
  attempts  Int           @default(0)
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId, type])
}

/// Coach-issued invitation. The raw token only exists in the one-time invite URL; the hash is stored.
model Invite {
  id         String     @id @default(cuid())
  coachId    String
  name       String
  email      String
  phone      String?
  programId  String?
  /// Pipeline lead this invite converts; the lead turns ACTIVE when the invite is accepted.
  leadId     String?
  startDate  DateTime?  @db.Date
  weightUnit WeightUnit @default(KG)
  tokenHash  String     @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())

  coach   User     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([coachId, acceptedAt])
}

/// Tenancy boundary. One active coach per client (MVP).
model CoachClient {
  id        String            @id @default(cuid())
  coachId   String
  clientId  String            @unique
  status    CoachClientStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime          @default(now())

  // Per-client engine overrides (null = inherit coach rules / defaults).
  loadIncrementKg  Decimal? @db.Decimal(5, 2)
  rpeCap           Decimal? @db.Decimal(3, 1)
  repsMin          Int?
  repsMax          Int?
  deloadPercent    Int?
  sessionsAnalyzed Int?
  autoApprove      Boolean  @default(false)
  /// Auto-approve only INCREASE_LOAD calls whose jump is at most this; null = any size.
  autoApproveMaxKg Decimal? @db.Decimal(5, 2)

  coach  User @relation("CoachSide", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("ClientSide", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([coachId, status])
}

// ─────────────── Exercise Catalog ───────────────

/// Global when coachId and ownerId are both null; coachId = coach's custom exercise; ownerId = an athlete's own
/// custom exercise. Never both (CHECK in migration).
model Exercise {
  id              String             @id @default(cuid())
  name            String
  /// Main primary muscle: the engine, swaps and filters key on it. Also stored as a PRIMARY row in `muscles`.
  muscleGroup     MuscleGroup
  equipment       Equipment?
  pattern         MovementPattern?
  profile         ResistanceProfile?
  position        ExercisePosition?
  /// Smallest load jump used by the engine (e.g. 2.5 upper, 5.0 lower).
  loadIncrementKg Decimal            @default(2.5) @db.Decimal(5, 2)
  /// Exercise-level engine rules (null = inherit). Layer between client override and prescription.
  rpeCap          Decimal?           @db.Decimal(3, 1)
  repsMin         Int?
  repsMax         Int?
  /// Optional https link to a demo video (YouTube, Vimeo, etc.). Shown in the library and the logger.
  demoUrl         String?            @db.VarChar(300)
  /// Soft delete: hidden from lists and pickers, history stays intact.
  archivedAt      DateTime?
  coachId         String?
  ownerId         String?
  createdAt       DateTime           @default(now())

  coach             User?                       @relation("CoachExercises", fields: [coachId], references: [id], onDelete: Cascade)
  owner             User?                       @relation("OwnedExercises", fields: [ownerId], references: [id], onDelete: Cascade)
  muscles           ExerciseMuscle[]
  workoutExercises  WorkoutExercise[]
  exerciseLogs      ExerciseLog[]
  recommendations   ProgressionRecommendation[]
  swappedFromLogs   ExerciseLog[]               @relation("SwappedFrom")
  baselines         ClientBaseline[]
  limitations       Limitation[]
  templateExercises WorkoutTemplateExercise[]
  exerciseNotes     ExerciseNote[]
  personalRecords   PersonalRecord[]

  @@unique([coachId, name])
  @@unique([ownerId, name])
  @@index([muscleGroup])
}

/// Every muscle an exercise trains. The exercise's own `muscleGroup` is always one of the PRIMARY rows.
model ExerciseMuscle {
  exerciseId String
  muscle     MuscleGroup
  role       MuscleRole

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscle])
  @@index([muscle])
}

// ─────────────── Program Templates ───────────────

model Program {
  id             String   @id @default(cuid())
  coachId        String
  name           String
  description    String?
  durationWeeks  Int
  isTemplate     Boolean  @default(false)
  /// SHA-256 (hex) of the read-only preview token. The raw token is shown once and never stored.
  shareTokenHash String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  coach         User                   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  workouts      Workout[]
  assignments   ProgramAssignment[]
  invites       Invite[]
  mesocycles    Mesocycle[]
  sports        ProgramSportCategory[]
  roadmapPhases RoadmapPhase[]

  @@index([coachId])
}

/// One training day inside a program (e.g. Week 2 / Day 1 "Upper A").
model Workout {
  id         String @id @default(cuid())
  programId  String
  weekNumber Int // 1..durationWeeks
  dayNumber  Int // 1..7
  name       String

  program     Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
  workoutLogs WorkoutLog[]
  scheduled   ScheduledWorkout[]

  @@unique([programId, weekNumber, dayNumber])
}

/// Prescription for one exercise in a workout.
model WorkoutExercise {
  id             String   @id @default(cuid())
  workoutId      String
  exerciseId     String
  order          Int
  targetSets     Int
  targetRepsMin  Int
  targetRepsMax  Int
  targetRpe      Decimal? @db.Decimal(3, 1)
  targetWeightKg Decimal? @db.Decimal(6, 2)
  restSeconds    Int?
  notes          String?

  workout      Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise     Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  exerciseLogs ExerciseLog[]

  @@unique([workoutId, order])
  @@index([exerciseId])
}

/// Program instance for a specific client.
model ProgramAssignment {
  id        String           @id @default(cuid())
  programId String
  clientId  String
  startDate DateTime         @db.Date
  status    AssignmentStatus @default(ACTIVE)
  /// Set when assigned through a client group (bulk assign).
  groupId   String?
  createdAt DateTime         @default(now())

  program     Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  client      User               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group       ClientGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  workoutLogs WorkoutLog[]
  scheduled   ScheduledWorkout[]
  // Partial unique "one ACTIVE per client" added in raw migration SQL.

  @@index([clientId, status])
  @@index([groupId])
}

// ─────────────── Logging (actuals) ───────────────

/// One performed session.
model WorkoutLog {
  id           String   @id @default(cuid())
  clientId     String
  assignmentId String?
  workoutId    String? // template day this session followed; null = ad-hoc
  performedAt  DateTime
  notes        String?
  /// Audit: the coach who logged this session for the client (live or in person). Null = the client logged it.
  loggedById   String?
  createdAt    DateTime @default(now())

  client       User               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  loggedBy     User?              @relation("LoggedBy", fields: [loggedById], references: [id], onDelete: SetNull)
  liveEntry    LiveParticipant?
  assignment   ProgramAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  workout      Workout?           @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  exerciseLogs ExerciseLog[]
  feedback     SessionFeedback[]

  @@index([clientId, performedAt(sort: Desc)])
}

/// One exercise performed within a session. Engine's unit of history.
model ExerciseLog {
  id                    String  @id @default(cuid())
  workoutLogId          String
  exerciseId            String
  workoutExerciseId     String? // prescription it fulfilled (targets snapshot source)
  order                 Int
  /// Set when the client swapped away from the prescribed exercise.
  swappedFromExerciseId String?
  swapReason            String?
  /// Free-text note on this lift in this session.
  notes                 String?

  workoutLog      WorkoutLog        @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise        Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  swappedFrom     Exercise?         @relation("SwappedFrom", fields: [swappedFromExerciseId], references: [id], onDelete: SetNull)
  workoutExercise WorkoutExercise?  @relation(fields: [workoutExerciseId], references: [id], onDelete: SetNull)
  sets            SetLog[]
  feedback        SessionFeedback[]

  @@unique([workoutLogId, order])
  @@index([exerciseId, workoutLogId])
}

model SetLog {
  id            String   @id @default(cuid())
  exerciseLogId String
  setNumber     Int
  reps          Int
  weightKg      Decimal  @db.Decimal(6, 2)
  rpe           Decimal? @db.Decimal(3, 1) // CHECK (rpe BETWEEN 1 AND 10) in migration
  isWarmup      Boolean  @default(false)
  /// Reps in reserve; CHECK (rir BETWEEN 0 AND 10) in migration.
  rir           Int?
  /// Free text such as `3-1-1-0`; shape validated by the API.
  tempo         String?  @db.VarChar(16)
  /// Rest taken before this set; CHECK (restSeconds BETWEEN 0 AND 3600) in migration.
  restSeconds   Int?
  /// Client-generated id of a live-logged set, so an offline retry never logs it twice.
  requestId     String?  @unique @db.Uuid

  exerciseLog    ExerciseLog       @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  personalRecord PersonalRecord?
  feedback       SessionFeedback[]
  videos         SetVideo[]

  @@unique([exerciseLogId, setNumber])
}

// ─────────────── Progression Engine Output ───────────────

model ProgressionRecommendation {
  id                   String               @id @default(cuid())
  clientId             String
  exerciseId           String
  action               RecommendationAction
  status               RecommendationStatus @default(PENDING)
  recommendedWeightKg  Decimal?             @db.Decimal(6, 2)
  recommendedRepsMin   Int?
  recommendedRepsMax   Int?
  recommendedSets      Int?
  reason               String // human-readable rule explanation
  /// Metrics snapshot the decision used: per-session volume, top-set e1RM, avg RPE.
  metrics              Json
  /// ExerciseLog ids analysed (2–3), for auditability.
  sourceExerciseLogIds String[]
  createdAt            DateTime             @default(now())
  resolvedAt           DateTime?
  /// Coach override of the engine target (the engine fields above stay untouched).
  overrideWeightKg     Decimal?             @db.Decimal(6, 2)
  overrideRepsMin      Int?
  overrideRepsMax      Int?
  overrideRpe          Decimal?             @db.Decimal(3, 1)
  overrideNote         String?
  overriddenById       String?
  overriddenAt         DateTime?
  autoApproved         Boolean              @default(false)
  /// Resolved engine settings with the source of each value.
  settings             Json?

  client   User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([clientId, exerciseId, createdAt(sort: Desc)])
  @@index([clientId, status])
}

// ─────────────── Profiles, baselines, coach rules ───────────────

model ClientProfile {
  clientId         String      @id
  goals            String[]
  goalNote         String?
  experience       Experience?
  daysPerWeek      Int?
  /// ISO weekdays, 1 = Monday … 7 = Sunday.
  trainingDays     Int[]
  sessionLengthMin Int?
  limitations      String[]
  limitationsNote  String?
  updatedAt        DateTime    @updatedAt

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/// Starting weight from onboarding; used to prefill the logger before history exists.
model ClientBaseline {
  id         String   @id @default(cuid())
  clientId   String
  exerciseId String
  weightKg   Decimal? @db.Decimal(6, 2)
  reps       Int?
  unknown    Boolean  @default(false)

  client   User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([clientId, exerciseId])
}

/// Coach-level engine thresholds. Null = engine default.
model CoachEngineRules {
  coachId             String   @id
  rpeCap              Decimal? @db.Decimal(3, 1)
  loadMarginRpe       Decimal? @db.Decimal(3, 1)
  highRpe             Decimal? @db.Decimal(3, 1)
  plateauTolerancePct Decimal? @db.Decimal(4, 2)
  declineThresholdPct Decimal? @db.Decimal(4, 2)
  deloadPercent       Int?
  sessionsAnalyzed    Int?
  updatedAt           DateTime @updatedAt

  coach User @relation(fields: [coachId], references: [id], onDelete: Cascade)
}

/// A client's injury or limitation. Advisory only: it flags prescriptions and sorts swaps, it never blocks logging.
/// Exactly one target column is set, matching `target` (enforced by a CHECK): muscleGroup, exerciseId, joint or pattern.
model Limitation {
  id          String             @id @default(cuid())
  clientId    String
  target      LimitationTarget
  muscleGroup MuscleGroup?
  exerciseId  String?
  joint       Joint?
  pattern     MovementPattern?
  severity    LimitationSeverity
  note        String?
  startsOn    DateTime           @db.Date
  endsOn      DateTime?          @db.Date
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  client   User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([clientId, endsOn])
}

// ─────────────── Templates and notes ───────────────

/// A client's folder of workout templates. Names are unique per client.
model TemplateFolder {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  createdAt DateTime @default(now())

  client    User              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templates WorkoutTemplate[]

  @@unique([clientId, name])
}

/// A reusable freeform workout the client starts from the logger. Deleting a folder keeps its templates.
model WorkoutTemplate {
  id        String   @id @default(cuid())
  clientId  String
  folderId  String?
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    User                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  folder    TemplateFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  exercises WorkoutTemplateExercise[]

  @@index([clientId, folderId])
}

model WorkoutTemplateExercise {
  id          String  @id @default(cuid())
  templateId  String
  exerciseId  String
  order       Int
  targetSets  Int
  repsMin     Int?
  repsMax     Int?
  restSeconds Int?
  tempo       String? @db.VarChar(16)

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([templateId, order])
}

/// A persistent note on one exercise (cues, setup, what to fix). Shown every time the client logs it.
model ExerciseNote {
  id         String   @id @default(cuid())
  clientId   String
  exerciseId String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client   User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([clientId, exerciseId])
}

/// Heaviest working set a client has done at an exact rep count. Warm-ups never count. Derived from logs:
/// `RecordsService.rebuild` recomputes a client's rows for an exercise whenever a log is created, edited or deleted.
model PersonalRecord {
  id         String   @id @default(cuid())
  clientId   String
  exerciseId String
  reps       Int
  weightKg   Decimal  @db.Decimal(6, 2)
  /// Epley estimate of the record set.
  e1rmKg     Decimal  @db.Decimal(6, 2)
  setLogId   String   @unique
  achievedAt DateTime

  client   User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setLog   SetLog   @relation(fields: [setLogId], references: [id], onDelete: Cascade)

  @@unique([clientId, exerciseId, reps])
  @@index([clientId, achievedAt(sort: Desc)])
}

// ─────────────── Periodization ───────────────

/// A training block (e.g. weeks 1-4 hypertrophy) inside a program. Weeks never overlap between blocks.
model Mesocycle {
  id        String  @id @default(cuid())
  programId String
  name      String
  focus     String?
  startWeek Int
  endWeek   Int
  position  Int

  program     Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  microcycles Microcycle[]

  @@index([programId, position])
}

/// A run of weeks inside a mesocycle with a shared intensity / volume intent (a deload week is a microcycle).
model Microcycle {
  id             String   @id @default(cuid())
  mesocycleId    String
  label          String
  startWeek      Int
  endWeek        Int
  isDeload       Boolean  @default(false)
  rpeMin         Decimal? @db.Decimal(3, 1)
  rpeMax         Decimal? @db.Decimal(3, 1)
  /// Volume change versus the block baseline, percent (e.g. -35 on a deload).
  volumeDeltaPct Int?

  mesocycle Mesocycle @relation(fields: [mesocycleId], references: [id], onDelete: Cascade)

  @@index([mesocycleId])
}

/// Seeded catalog of sports / disciplines a program is built for. `id` is the slug.
model SportCategory {
  id    String @id
  name  String @unique
  /// Display grouping, e.g. "Strength", "Field", "Combat".
  group String

  programs ProgramSportCategory[]
}

model ProgramSportCategory {
  programId       String
  sportCategoryId String

  program Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  sport   SportCategory @relation(fields: [sportCategoryId], references: [id], onDelete: Cascade)

  @@id([programId, sportCategoryId])
  @@index([sportCategoryId])
}

// ─────────────── Client groups ───────────────

model ClientGroup {
  id        String   @id @default(cuid())
  coachId   String
  name      String
  createdAt DateTime @default(now())

  coach       User                @relation(fields: [coachId], references: [id], onDelete: Cascade)
  members     ClientGroupMember[]
  assignments ProgramAssignment[]

  @@unique([coachId, name])
}

model ClientGroupMember {
  groupId  String
  clientId String

  group  ClientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  client User        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([groupId, clientId])
  @@index([clientId])
}

// ─────────────── Calendar ───────────────

/// One dated session on a client's calendar. Created from the program's (week, day) formula, then the coach may
/// move or skip it. Completed rows are history and never change; program edits touch future PLANNED rows only.
model ScheduledWorkout {
  id           String          @id @default(cuid())
  assignmentId String
  workoutId    String
  clientId     String
  date         DateTime        @db.Date
  status       ScheduledStatus @default(PLANNED)
  /// Set when a coach moved it: program edits no longer re-date it.
  movedAt      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  assignment ProgramAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  workout    Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  client     User              @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, workoutId])
  @@index([clientId, date])
}

// ─────────────── Session review ───────────────

/// Coach feedback on a logged session. Scope: setLogId set = one set; else exerciseLogId set = one lift; else whole
/// session. `carryForward` pins it to the client's next matching exercise (or next session) in `GET /me/today`.
model SessionFeedback {
  id            String   @id @default(cuid())
  workoutLogId  String
  exerciseLogId String?
  setLogId      String?
  coachId       String
  body          String   @db.VarChar(1000)
  carryForward  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workoutLog  WorkoutLog   @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exerciseLog ExerciseLog? @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  setLog      SetLog?      @relation(fields: [setLogId], references: [id], onDelete: Cascade)
  coach       User         @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([workoutLogId])
  @@index([exerciseLogId])
}

// ─────────────── Billing ───────────────

enum Feature {
  AI_COACH
  AI_WORKOUT_GENERATOR
  VOICE_LOGGING
  PROGRAM_CREATION
  PERSONAL_RECORDS
  EXERCISE_STATS
  MUSCLE_ANALYTICS
  AI_FOOD_PHOTOS
  COACH_CLIENTS
  CLIENT_PAYMENTS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingEventType {
  TRIAL_STARTED
  CHECKOUT_COMPLETED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_CANCELED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
}

enum OfferInterval {
  ONE_TIME
  MONTH
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

/// Platform plan. Mirrors PLANS in @coaching/shared (migration inserts, seed upserts). id = slug.
model Plan {
  id          String @id
  name        String
  role        Role
  priceCents  Int
  currency    String @default("usd")
  trialDays   Int    @default(0)
  /// Coach seats included; null for athlete plans.
  clientLimit Int?

  entitlements  Entitlement[]
  subscriptions Subscription[]
}

/// Feature granted by a plan.
model Entitlement {
  planId  String
  feature Feature

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, feature])
}

/// A user's platform plan. One row per user; cancellation keeps the row (status CANCELED) and never touches data.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  planId               String
  status               SubscriptionStatus
  /// Coach seats; null = the plan's clientLimit.
  clientLimit          Int?
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeSubscriptionId String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([status])
}

/// Append-only audit of platform billing changes.
model BillingEvent {
  id            String              @id @default(cuid())
  userId        String
  type          BillingEventType
  planId        String?
  status        SubscriptionStatus?
  amountCents   Int?
  /// One audit row per Stripe event: concurrent deliveries of the same event cannot add a second.
  stripeEventId String?             @unique
  createdAt     DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Webhook idempotency: one row per Stripe event id. processedAt set once handling succeeded.
model StripeEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?
}

/// Something a coach sells to their clients. Checkout builds the Stripe price inline, so no Stripe ids live here.
model CoachOffer {
  id          String        @id @default(cuid())
  coachId     String
  name        String
  description String?
  priceCents  Int
  currency    String        @default("usd")
  interval    OfferInterval
  /// Soft archive: hidden from clients, existing subscriptions and payments stay.
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())

  coach         User                 @relation(fields: [coachId], references: [id], onDelete: Cascade)
  subscriptions ClientSubscription[]
  payments      Payment[]

  @@index([coachId, archivedAt])
}

/// A client's recurring purchase of a coach offer.
model ClientSubscription {
  id                   String             @id @default(cuid())
  offerId              String
  coachId              String
  clientId             String
  status               SubscriptionStatus
  amountCents          Int
  currency             String             @default("usd")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeSubscriptionId String             @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  offer    CoachOffer @relation(fields: [offerId], references: [id], onDelete: NoAction)
  coach    User       @relation("CoachSales", fields: [coachId], references: [id], onDelete: Cascade)
  client   User       @relation("ClientPurchases", fields: [clientId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([coachId, status])
  @@index([clientId])
}

/// One settled (or failed) charge for a coach offer. stripeRef = invoice id (recurring) or checkout session id (one-time).
model Payment {
  id                   String        @id @default(cuid())
  coachId              String
  clientId             String
  offerId              String?
  clientSubscriptionId String?
  amountCents          Int
  currency             String        @default("usd")
  status               PaymentStatus
  stripeRef            String        @unique
  paidAt               DateTime
  createdAt            DateTime      @default(now())

  coach              User                @relation("CoachPayments", fields: [coachId], references: [id], onDelete: Cascade)
  client             User                @relation("ClientPayments", fields: [clientId], references: [id], onDelete: Cascade)
  offer              CoachOffer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  clientSubscription ClientSubscription? @relation(fields: [clientSubscriptionId], references: [id], onDelete: SetNull)

  @@index([coachId, paidAt])
}

// ─────────────── Lead pipeline ───────────────

enum LeadStage {
  NEW
  INTAKE_SENT
  CALL_BOOKED
  /// Converted: the lead accepted an invite and is a client.
  ACTIVE
  LOST
}

enum LeadSource {
  WEB_FORM
  MANUAL
}

/// Public landing identity for a coach's intake form (`/apply/<slug>`).
model CoachBrand {
  id             String   @id @default(cuid())
  coachId        String   @unique
  slug           String   @unique
  headline       String   @db.VarChar(120)
  intro          String   @default("") @db.VarChar(500)
  acceptingLeads Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  coach User @relation(fields: [coachId], references: [id], onDelete: Cascade)
}

/// The coach's custom questions, shown after the fixed fields (name, email, goal, days, experience).
model IntakeForm {
  id        String   @id @default(cuid())
  coachId   String   @unique
  /// IntakeQuestion[] (see @coaching/shared).
  questions Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach     User             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  responses IntakeResponse[]
}

model Lead {
  id                String     @id @default(cuid())
  coachId           String
  name              String     @db.VarChar(100)
  email             String
  phone             String?    @db.VarChar(40)
  goal              String?    @db.VarChar(80)
  trainingDays      Int?
  experienceYears   Int?
  source            LeadSource
  stage             LeadStage  @default(NEW)
  monthlyValueCents Int?
  callAt            DateTime?
  notes             String?    @db.VarChar(2000)
  convertedClientId String?    @unique
  convertedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  coach           User             @relation("CoachLeads", fields: [coachId], references: [id], onDelete: Cascade)
  convertedClient User?            @relation("ConvertedLead", fields: [convertedClientId], references: [id], onDelete: SetNull)
  responses       IntakeResponse[]
  invites         Invite[]

  /// One lead per coach and email: a repeat application adds a response instead of a card.
  @@unique([coachId, email])
  @@index([coachId, stage])
}

/// One submission of the intake form. Answers keep the question text so later form edits never orphan them.
model IntakeResponse {
  id        String   @id @default(cuid())
  leadId    String
  formId    String?
  /// { question: string; answer: string }[]
  answers   Json
  createdAt DateTime @default(now())

  lead Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  form IntakeForm? @relation(fields: [formId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

// ─────────────── Resource vault ───────────────

enum ResourceKind {
  GUIDE
  VIDEO
  SHEET
  OTHER
}

/// A file in the coach's library, stored in Cloudflare R2 under `storageKey`. `uploadedAt` is null until the
/// browser's direct upload is confirmed; unconfirmed rows are never listed.
model Resource {
  id          String       @id @default(cuid())
  coachId     String
  title       String       @db.VarChar(120)
  description String?      @db.VarChar(500)
  kind        ResourceKind
  fileName    String       @db.VarChar(200)
  contentType String
  sizeBytes   Int
  storageKey  String       @unique
  uploadedAt  DateTime?
  createdAt   DateTime     @default(now())

  coach  User            @relation(fields: [coachId], references: [id], onDelete: Cascade)
  shares ResourceShare[]

  @@index([coachId, createdAt])
}

model ResourceShare {
  id         String   @id @default(cuid())
  resourceId String
  clientId   String
  createdAt  DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  client   User     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([resourceId, clientId])
  @@index([clientId])
}

// ─────────────── Client roadmaps ───────────────

/// One multi-month plan per client: phases on a timeline, numeric goals, and dated events (meets).
model ClientRoadmap {
  id        String   @id @default(cuid())
  coachId   String
  clientId  String   @unique
  title     String   @db.VarChar(120)
  notes     String?  @db.VarChar(1000)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach  User           @relation("CoachRoadmaps", fields: [coachId], references: [id], onDelete: Cascade)
  client User           @relation("ClientRoadmap", fields: [clientId], references: [id], onDelete: Cascade)
  phases RoadmapPhase[]
  goals  RoadmapGoal[]
  events ClientEvent[]

  @@index([coachId])
}

model RoadmapPhase {
  id        String   @id @default(cuid())
  roadmapId String
  position  Int
  name      String   @db.VarChar(60)
  focus     String?  @db.VarChar(120)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  programId String?

  roadmap ClientRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  program Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([roadmapId, position])
}

model RoadmapGoal {
  id           String    @id @default(cuid())
  roadmapId    String
  position     Int
  label        String    @db.VarChar(60)
  unit         String    @db.VarChar(12)
  targetValue  Decimal   @db.Decimal(8, 2)
  currentValue Decimal?  @db.Decimal(8, 2)
  dueDate      DateTime? @db.Date

  roadmap ClientRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId, position])
}

model ClientEvent {
  id        String   @id @default(cuid())
  roadmapId String
  clientId  String
  name      String   @db.VarChar(80)
  date      DateTime @db.Date
  location  String?  @db.VarChar(120)
  notes     String?  @db.VarChar(500)

  roadmap ClientRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  client  User          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
}

// ─────────────── Messaging ───────────────

/// One thread per coach–client pair. Created on first open. A client who changes coach starts a new thread.
model Conversation {
  id            String    @id @default(cuid())
  coachId       String
  clientId      String
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  coach    User          @relation("CoachConversations", fields: [coachId], references: [id], onDelete: Cascade)
  client   User          @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  messages Message[]
  reads    MessageRead[]

  @@unique([coachId, clientId])
  @@index([coachId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.VarChar(4000)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
}

/// Read pointer per participant: every message at or before `lastReadAt` counts as read.
model MessageRead {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

// ─────────────── Check-ins ───────────────

enum CheckInQuestionKind {
  NUMBER
  SCALE
  TEXT
}

enum CheckInCadence {
  WEEKLY
  ONCE
}

model CheckInTemplate {
  id        String   @id @default(cuid())
  coachId   String
  title     String   @db.VarChar(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach     User              @relation(fields: [coachId], references: [id], onDelete: Cascade)
  questions CheckInQuestion[]
  schedules CheckInSchedule[]

  @@index([coachId])
}

model CheckInQuestion {
  id         String              @id @default(cuid())
  templateId String
  position   Int
  prompt     String              @db.VarChar(200)
  kind       CheckInQuestionKind
  required   Boolean             @default(true)
  /// NUMBER only, e.g. "kg" or "hrs".
  unit       String?             @db.VarChar(12)

  template CheckInTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
}

/// Assigns a template to a client. WEEKLY repeats on `weekday` (0 = Sunday); ONCE is due on `dueDate`.
model CheckInSchedule {
  id         String         @id @default(cuid())
  templateId String
  clientId   String
  cadence    CheckInCadence
  weekday    Int?
  dueDate    DateTime?      @db.Date
  startDate  DateTime       @db.Date
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())

  template  CheckInTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  client    User              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responses CheckInResponse[]

  @@unique([templateId, clientId])
  @@index([clientId, active])
}

/// One answer set per schedule period. `answers` snapshots each prompt so template edits never rewrite history.
model CheckInResponse {
  id          String    @id @default(cuid())
  scheduleId  String
  clientId    String
  periodDate  DateTime  @db.Date
  answers     Json
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  coachReply  String?   @db.VarChar(2000)
  repliedAt   DateTime?

  schedule CheckInSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  client   User            @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, periodDate])
  @@index([clientId, submittedAt])
}

// ─────────────── Body ───────────────

model BodyweightEntry {
  id        String   @id @default(cuid())
  clientId  String
  date      DateTime @db.Date
  weightKg  Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
}

model BodyGoal {
  id         String    @id @default(cuid())
  clientId   String    @unique
  targetKg   Decimal   @db.Decimal(5, 2)
  targetDate DateTime? @db.Date
  updatedAt  DateTime  @updatedAt

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum PhotoPose {
  FRONT
  SIDE
  BACK
}

/// Private to the client until `sharedWithCoach`. Hidden until `uploadedAt` (object checked, metadata-free). Delete is hard.
model ProgressPhoto {
  id              String    @id @default(cuid())
  clientId        String
  pose            PhotoPose
  takenOn         DateTime  @db.Date
  sizeBytes       Int
  storageKey      String    @unique
  sharedWithCoach Boolean   @default(false)
  uploadedAt      DateTime?
  createdAt       DateTime  @default(now())

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, takenOn])
}

// ─────────────── Set videos and form checks ───────────────

enum MediaKind {
  VIDEO
  AUDIO
}

/// One stored file in R2. Hidden until `uploadedAt` (size and file signature checked). Delete is hard.
model MediaAsset {
  id          String    @id @default(cuid())
  ownerId     String
  kind        MediaKind
  contentType String    @db.VarChar(40)
  sizeBytes   Int
  storageKey  String    @unique
  uploadedAt  DateTime?
  createdAt   DateTime  @default(now())

  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  setVideo    SetVideo?
  reviewAudio FormReview? @relation("ReviewAudio")

  @@index([ownerId, kind])
}

enum VideoSide {
  LEFT
  RIGHT
  BOTH
}

/// A clip of one logged set. One clip per set and side, so a unilateral set can hold a left and a right clip.
model SetVideo {
  id        String    @id @default(cuid())
  setLogId  String
  clientId  String
  mediaId   String    @unique
  side      VideoSide
  createdAt DateTime  @default(now())

  setLog SetLog      @relation(fields: [setLogId], references: [id], onDelete: Cascade)
  client User        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  media  MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  review FormReview?

  @@unique([setLogId, side])
  @@index([clientId, createdAt])
}

enum FormReviewStatus {
  PENDING
  REVIEWED
}

/// A client's request for the coach to review one clip. The coach is fixed at request time.
model FormReview {
  id           String           @id @default(cuid())
  setVideoId   String           @unique
  clientId     String
  coachId      String
  status       FormReviewStatus @default(PENDING)
  summary      String?          @db.VarChar(2000)
  /// Narrated review (coach voice over the clip).
  audioMediaId String?          @unique
  requestedAt  DateTime         @default(now())
  reviewedAt   DateTime?

  setVideo    SetVideo          @relation(fields: [setVideoId], references: [id], onDelete: Cascade)
  client      User              @relation("ClientFormReviews", fields: [clientId], references: [id], onDelete: Cascade)
  coach       User              @relation("CoachFormReviews", fields: [coachId], references: [id], onDelete: Cascade)
  audio       MediaAsset?       @relation("ReviewAudio", fields: [audioMediaId], references: [id], onDelete: SetNull)
  annotations VideoAnnotation[]

  @@index([coachId, status, requestedAt])
}

/// Drawing on one frame. `shapes` holds arrows, angles and freehand strokes in 0–1 frame coordinates.
model VideoAnnotation {
  id          String   @id @default(cuid())
  reviewId    String
  timestampMs Int
  shapes      Json
  note        String?  @db.VarChar(300)
  createdAt   DateTime @default(now())

  review FormReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, timestampMs])
}

// ─────────────── Calls and scheduling ───────────────

/// The coach's weekly bookable hours. `windows` = [{ weekday, startMinute, endMinute }] in `timezone` (IANA).
model Availability {
  id         String   @id @default(cuid())
  coachId    String   @unique
  timezone   String   @db.VarChar(64)
  windows    Json
  /// Default video room link copied onto new bookings.
  meetingUrl String?  @db.VarChar(500)
  updatedAt  DateTime @updatedAt

  coach User @relation(fields: [coachId], references: [id], onDelete: Cascade)
}

enum CallKind {
  CHECK_IN
  ONBOARDING
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// Instants are UTC. Overlap among a coach's CONFIRMED bookings is refused under a per-coach advisory lock.
model Booking {
  id          String        @id @default(cuid())
  coachId     String
  clientId    String
  kind        CallKind
  startsAt    DateTime
  endsAt      DateTime
  status      BookingStatus @default(CONFIRMED)
  agenda      String?       @db.VarChar(300)
  meetingUrl  String?       @db.VarChar(500)
  bookedById  String
  cancelledAt DateTime?
  createdAt   DateTime      @default(now())

  coach  User @relation("CoachBookings", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([coachId, status, startsAt])
  @@index([clientId, status, startsAt])
}

// ─────────────── Automations ───────────────

enum AutomationTrigger {
  PAYMENT_RECEIVED
  SESSION_MISSED
  CHECK_IN_OVERDUE
}

/// IF trigger fires `delayHours` after its event THEN send `messageBody` in the coach–client thread.
/// Only events due after the rule was created fire, so a new rule never sends a backlog.
model AutomationRule {
  id          String            @id @default(cuid())
  coachId     String
  name        String            @db.VarChar(80)
  trigger     AutomationTrigger
  delayHours  Int
  messageBody String            @db.VarChar(1000)
  enabled     Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  coach User            @relation(fields: [coachId], references: [id], onDelete: Cascade)
  runs  AutomationRun[]

  @@index([coachId])
}

/// One fired action. `idempotencyKey` = rule + event, unique, so a rule fires once per event across retries and instances.
model AutomationRun {
  id             String   @id @default(cuid())
  ruleId         String
  clientId       String
  idempotencyKey String   @unique @db.VarChar(200)
  messageId      String?
  firedAt        DateTime @default(now())

  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  client User           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([ruleId, firedAt])
}

// ─────────────── Train Together ───────────────

enum LiveMode {
  REMOTE
  IN_PERSON
}

/// A coach-run session. At most one open (endedAt null) per coach (partial unique index in migration).
model LiveSession {
  id        String    @id @default(cuid())
  coachId   String
  title     String    @db.VarChar(80)
  mode      LiveMode
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  coach        User              @relation(fields: [coachId], references: [id], onDelete: Cascade)
  participants LiveParticipant[]

  @@index([coachId, startedAt])
}

/// A client in a live session. `workoutLogId` is the log the coach writes into, created on the first set.
model LiveParticipant {
  id           String   @id @default(cuid())
  sessionId    String
  clientId     String
  workoutLogId String?  @unique
  joinedAt     DateTime @default(now())

  session    LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  client     User        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workoutLog WorkoutLog? @relation(fields: [workoutLogId], references: [id], onDelete: SetNull)

  @@unique([sessionId, clientId])
  @@index([clientId])
}

// ─────────────── Nutrition ───────────────

enum FoodSource {
  CUSTOM
  USDA
  CNF
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

/// Nutrients are per 100 g. Global when ownerId is null (starter USDA rows from the migration); otherwise a user's
/// custom food. Archived instead of deleted so templates and plans that use it keep working.
model Food {
  id           String     @id @default(cuid())
  ownerId      String?
  source       FoodSource @default(CUSTOM)
  name         String     @db.VarChar(120)
  brand        String?    @db.VarChar(80)
  servingG     Decimal    @default(100) @db.Decimal(6, 1)
  servingLabel String?    @db.VarChar(40)
  kcal         Decimal    @db.Decimal(5, 1)
  proteinG     Decimal    @db.Decimal(4, 1)
  carbsG       Decimal    @db.Decimal(4, 1)
  fatG         Decimal    @db.Decimal(4, 1)
  fiberG       Decimal?   @db.Decimal(4, 1)
  sodiumMg     Decimal?   @db.Decimal(7, 1)
  potassiumMg  Decimal?   @db.Decimal(7, 1)
  calciumMg    Decimal?   @db.Decimal(7, 1)
  ironMg       Decimal?   @db.Decimal(6, 2)
  magnesiumMg  Decimal?   @db.Decimal(7, 1)
  vitaminDMcg  Decimal?   @db.Decimal(6, 2)
  archivedAt   DateTime?
  createdAt    DateTime   @default(now())

  owner         User?              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entries       MealEntry[]
  templateItems MealTemplateItem[]
  planItems     MealPlanItem[]
  favorites     FoodFavorite[]

  @@index([ownerId, name])
}

/// One logged portion. Name and nutrients are a snapshot at log time, so food edits never rewrite history.
model MealEntry {
  id          String     @id @default(cuid())
  clientId    String
  date        DateTime   @db.Date
  slot        MealSlot
  foodId      String?
  name        String     @db.VarChar(120)
  source      FoodSource
  grams       Decimal    @db.Decimal(6, 1)
  kcal        Decimal    @db.Decimal(6, 1)
  proteinG    Decimal    @db.Decimal(5, 1)
  carbsG      Decimal    @db.Decimal(5, 1)
  fatG        Decimal    @db.Decimal(5, 1)
  fiberG      Decimal?   @db.Decimal(5, 1)
  sodiumMg    Decimal?   @db.Decimal(8, 1)
  potassiumMg Decimal?   @db.Decimal(8, 1)
  calciumMg   Decimal?   @db.Decimal(8, 1)
  ironMg      Decimal?   @db.Decimal(7, 2)
  magnesiumMg Decimal?   @db.Decimal(8, 1)
  vitaminDMcg Decimal?   @db.Decimal(7, 2)
  createdAt   DateTime   @default(now())

  client User  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  food   Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([clientId, date])
}

/// Additive water entries; the day total is their sum (CHECK 1–5000 ml in migration).
model WaterLog {
  id        String   @id @default(cuid())
  clientId  String
  date      DateTime @db.Date
  ml        Int
  createdAt DateTime @default(now())

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
}

/// One per client. While `setById` is the client's current coach, only that coach may change it.
model NutritionTarget {
  id        String   @id @default(cuid())
  clientId  String   @unique
  kcal      Int
  proteinG  Int
  carbsG    Int
  fatG      Int
  fiberG    Int?
  waterMl   Int?
  setById   String?
  updatedAt DateTime @updatedAt

  client User  @relation("TargetClient", fields: [clientId], references: [id], onDelete: Cascade)
  setBy  User? @relation("TargetSetter", fields: [setById], references: [id], onDelete: SetNull)
}

/// Saved meal (servings = 1) or recipe (servings > 1). Logging scales each item by servings eaten / servings.
model MealTemplate {
  id        String   @id @default(cuid())
  ownerId   String
  name      String   @db.VarChar(80)
  servings  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items MealTemplateItem[]

  @@index([ownerId])
}

model MealTemplateItem {
  id         String  @id @default(cuid())
  templateId String
  foodId     String
  position   Int
  grams      Decimal @db.Decimal(6, 1)

  template MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  food     Food         @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model FoodFavorite {
  userId    String
  foodId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([userId, foodId])
}

/// Coach-assigned one-day meal plan. The client sees it only while that coach link is accessible.
model MealPlan {
  id        String   @id @default(cuid())
  coachId   String
  clientId  String
  name      String   @db.VarChar(80)
  notes     String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach  User           @relation("CoachMealPlans", fields: [coachId], references: [id], onDelete: Cascade)
  client User           @relation("ClientMealPlans", fields: [clientId], references: [id], onDelete: Cascade)
  meals  MealPlanMeal[]

  @@index([clientId])
  @@index([coachId])
}

model MealPlanMeal {
  id       String @id @default(cuid())
  planId   String
  position Int
  name     String @db.VarChar(80)

  plan  MealPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  items MealPlanItem[]

  @@index([planId])
}

model MealPlanItem {
  id       String  @id @default(cuid())
  mealId   String
  foodId   String
  position Int
  grams    Decimal @db.Decimal(6, 1)

  meal MealPlanMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food         @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([mealId])
}
