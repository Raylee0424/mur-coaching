DATABASE_URL=postgresql://postgres:04240@localhost:5432/coaching?schema=public
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
PORT=4000
WEB_URL=http://localhost:3000
# Which hops may set X-Forwarded-For (rate limits key on client IP): true/false, a hop count, or presets/subnets.
# "loopback" fits local dev. In production set it to the web server's address or private subnet.
TRUST_PROXY=loopback
# Stripe (optional: leave unset to run without payments). Test-mode keys from dashboard.stripe.com.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...        # `stripe listen --forward-to localhost:4000/api/v1/billing/webhook`
# STRIPE_PRICE_ATHLETE_PRO=price_...     # $11.99/month recurring price
# STRIPE_PRICE_COACH=price_...           # $19.99/month recurring price
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_... # Connect endpoint: `stripe listen --forward-connect-to localhost:4000/api/v1/billing/webhooks/connect`
# STRIPE_PLATFORM_FEE_PERCENT=0
# Cloudflare R2 for the resource vault (optional). Create a bucket and an API token with Object Read & Write, and
# allow PUT from the web origin in the bucket's CORS rules (AllowedHeaders: content-type).
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=...

# Cycle-log encryption (AES-256-GCM). 32 bytes base64: openssl rand -base64 32. Unset = cycle routes answer 503.
# CYCLE_ENCRYPTION_KEY=...

# AI tools (optional). Unset = deterministic server answers, no network calls. Never exposed to the browser.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-6
